<ContentDialog
    x:Class="ADOFAI.ModManager.Controls.ModDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ADOFAI.ModManager.Core.ViewModels"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Title, Mode=OneWay}"
    PrimaryButtonText="关闭"
    DefaultButton="Primary"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <x:Double x:Key="ContentDialogMaxWidth">900</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="560">
        <!--  元信息  -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="作者：" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Author, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock Text="状态：" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind ViewModel.VersionLine, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsLoadingVersions, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsLoadingVersions, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />

        <!--  描述  -->
        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
            <TextBlock
                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                LineHeight="20"
                FontSize="13" />
        </ScrollViewer>

        <!--  本地安装信息  -->
        <Expander Header="本地安装信息" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4" Margin="0,8">
                <TextBlock FontSize="12" TextWrapping="Wrap">
                    <Run Text="依赖： " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Run Text="{x:Bind ViewModel.RequirementsText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="12" TextWrapping="Wrap">
                    <Run Text="ManagerVersion： " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Run Text="{x:Bind ViewModel.ManagerVersionText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="12" TextWrapping="Wrap">
                    <Run Text="EntryMethod： " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Run Text="{x:Bind ViewModel.EntryMethodText, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Expander>

        <!--  版本历史  -->
        <Expander Header="版本历史" HorizontalAlignment="Stretch" Expanding="VersionExpander_Expanding">
            <ListView
                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                MaxHeight="200"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionHistoryItem">
                        <StackPanel Spacing="2" Margin="0,6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{x:Bind ReleasedAt}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Notes}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Expander>

        <!--  链接  -->
        <StackPanel Orientation="Horizontal" Spacing="16">
            <HyperlinkButton
                Content="在 Tuforums 打开"
                Click="OpenTufPage_Click"
                Visibility="{x:Bind ViewModel.TufPageUrl, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
