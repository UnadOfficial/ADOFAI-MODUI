<UserControl
    x:Class="ADOFAI.ModManager.Controls.ModCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:ADOFAI.ModManager.Core.Models.Tuforums"
    mc:Ignorable="d">

    <Border
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Padding="16"
        Margin="4"
        MinHeight="168">

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  ── 头部：图标 + 名称 + 徽章 ──  -->
            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  图标（无图标时用占位字形）  -->
                <Grid Width="64" Height="64" VerticalAlignment="Top">
                    <Ellipse Fill="{ThemeResource ControlFillColorDefaultBrush}" />
                    <Image
                        Source="{x:Bind ViewModel.IconPath, Mode=OneWay, Converter={StaticResource StringToImageSource}}"
                        Width="60" Height="60" />
                    <FontIcon
                        Glyph="&#xE74C;"
                        FontSize="26"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.IconPath, Mode=OneWay, Converter={StaticResource NullToVisible}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <!--  状态徽章  -->
                        <Border
                            CornerRadius="4"
                            Padding="6,2"
                            Background="{x:Bind ViewModel.StatusBadgeColor, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind ViewModel.StatusBadge, Mode=OneWay}"
                                FontSize="11"
                                FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Text="{x:Bind ViewModel.Author, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.Author, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />

                    <TextBlock
                        Text="{x:Bind ViewModel.VersionText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Visibility="{x:Bind ViewModel.VersionText, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Text="{x:Bind ViewModel.StatsText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.StatsText, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.UpdatedText, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  ── 描述摘要 ──  -->
            <TextBlock
                Grid.Row="1"
                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                FontSize="12"
                TextWrapping="Wrap"
                MaxLines="2"
                TextTrimming="CharacterEllipsis"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind ViewModel.Description, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />

            <!--  ── 标签彩条 ──  -->
            <ItemsControl
                Grid.Row="2"
                ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="model:TufTag">
                        <Border CornerRadius="10" Padding="8,2" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Name}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  ── 下载进度行 ──  -->
            <Grid
                Grid.Row="3"
                RowSpacing="4"
                Visibility="{x:Bind ViewModel.ShowProgress, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ProgressBar
                    Grid.Row="0"
                    Maximum="100"
                    IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}"
                    Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        Grid.Column="1"
                        Content="取消"
                        FontSize="11"
                        Padding="8,2"
                        Command="{x:Bind ViewModel.CancelOperationCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                </Grid>
            </Grid>

            <!--  ── 操作按钮行 ──  -->
            <Grid Grid.Row="4" VerticalAlignment="Bottom" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Content="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanPrimary, Mode=OneWay}"
                    Command="{x:Bind ViewModel.PrimaryActionCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PrimaryButtonToolTip, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="84" />

                <Button
                    Grid.Column="1"
                    Content="{x:Bind ViewModel.SecondaryButtonText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanSecondary, Mode=OneWay}"
                    Command="{x:Bind ViewModel.SecondaryActionCommand, Mode=OneWay}"
                    MinWidth="72"
                    Visibility="{x:Bind ViewModel.SecondaryButtonText, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />

                <Button
                    Grid.Column="3"
                    Command="{x:Bind ViewModel.OpenLocalFolderCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="打开 Mod 目录"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    Visibility="{x:Bind ViewModel.IsLocalOnly, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                    <FontIcon Glyph="&#xE838;" FontSize="15" />
                </Button>

                <Button
                    Grid.Column="4"
                    Command="{x:Bind ViewModel.OpenTufPageCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="在 Tuforums 打开"
                    Background="Transparent" BorderThickness="0" Padding="6"
                    Visibility="{x:Bind ViewModel.IsRemote, Mode=OneWay, Converter={StaticResource BoolToVisible}}">
                    <FontIcon Glyph="&#xE774;" FontSize="15" />
                </Button>

                <Button
                    Grid.Column="5"
                    Command="{x:Bind ViewModel.ShowDetailsCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="详情"
                    Background="Transparent" BorderThickness="0" Padding="6">
                    <FontIcon Glyph="&#xE946;" FontSize="15" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
