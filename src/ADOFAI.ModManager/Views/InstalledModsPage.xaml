<Page
    x:Class="ADOFAI.ModManager.Views.InstalledModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ADOFAI.ModManager.Controls"
    xmlns:vm="using:ADOFAI.ModManager.Core.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,16,28,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ── 页头与工具栏 ──  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="InstalledPage_Title"
                    Text="我的 Mod"
                    FontSize="28"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="{x:Bind ViewModel.GameRootText, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Command="{x:Bind ViewModel.UpdateAllCommand}"
                        IsEnabled="{x:Bind ViewModel.HasGameRoot, Mode=OneWay}"
                        Style="{ThemeResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.HasUpdates, Mode=OneWay, Converter={StaticResource BoolToVisible}}"
                        ToolTipService.ToolTip="一键更新全部可更新的 Mod">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="一键更新" />
                    </StackPanel>
                </Button>
                <Button Click="ImportZip_Click"
                        IsEnabled="{x:Bind ViewModel.HasGameRoot, Mode=OneWay}"
                        ToolTipService.ToolTip="从本地 zip 文件安装 Mod">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="导入本地 zip" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.OpenModsFolderCommand}"
                        IsEnabled="{x:Bind ViewModel.HasGameRoot, Mode=OneWay}"
                        ToolTipService.ToolTip="在资源管理器中打开 Mods 目录">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="打开 Mods 目录" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RescanCommand}"
                        IsEnabled="{x:Bind ViewModel.HasGameRoot, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="重新扫描" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  ── 过滤行 ──  -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="InstalledPage_Search"
                PlaceholderText="搜索已安装的 Mod…"
                QueryIcon="Find"
                IsEnabled="{x:Bind ViewModel.HasGameRoot, Mode=OneWay}"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <ComboBox
                Grid.Column="1"
                MinWidth="130"
                ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.HasGameRoot, Mode=OneWay}" />

            <ComboBox
                Grid.Column="2"
                MinWidth="130"
                ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.HasGameRoot, Mode=OneWay}" />

            <ProgressRing
                Grid.Column="3"
                Width="24" Height="24"
                IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
        </Grid>

        <!--  ── 提示 ──  -->
        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}"
            IsClosable="True"
            CloseButtonClick="Notice_CloseClick"
            Severity="{x:Bind ViewModel.NoticeIsError, Mode=OneWay, Converter={StaticResource BoolToSeverity}}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

        <!--  ── 未配置游戏目录时的引导面板  -->
        <Border
            Grid.Row="3"
            Visibility="{x:Bind ViewModel.IsGameRootMissing, Mode=OneWay, Converter={StaticResource BoolToVisible}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="480"
            Padding="32"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="44" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="未配置游戏路径" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="检测到尚未配置《冰与火之舞》的游戏安装目录。配置游戏路径后，方可管理已安装的 Mod、导入本地 zip 及调整 Mod 启用状态。"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="前往设置页配置" Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.NavigateToSettingsCommand}" />
            </StackPanel>
        </Border>

        <!--  ── 空状态（搜索无结果）  -->
        <Border
            Grid.Row="3"
            Visibility="{x:Bind ViewModel.IsInstalledFilterEmpty, Mode=OneWay, Converter={StaticResource BoolToVisible}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="460"
            Padding="32"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="未找到匹配的 Mod" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="当前搜索关键词或筛选条件下未找到任何已安装的 Mod。"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="重置筛选条件"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.ResetFiltersCommand}" />
            </StackPanel>
        </Border>

        <!--  ── 空状态（未安装任何 Mod）  -->
        <Border
            Grid.Row="3"
            Visibility="{x:Bind ViewModel.IsInstalledNoModsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisible}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="480"
            Padding="32"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8B7;" FontSize="44" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="暂无已安装的 Mod" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="您尚未在游戏目录中安装任何 Mod。前往“浏览 Mod”页面探索社区精选 Mod，或使用右上角按钮导入本地 zip 压缩包安装。"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="前往浏览 Mod" Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.NavigateToBrowseCommand}" />
            </StackPanel>
        </Border>

        <!--  ── Mod 卡片列表 ──  -->
        <ListView
            Grid.Row="3"
            Visibility="{x:Bind ViewModel.IsInstalledListVisible, Mode=OneWay, Converter={StaticResource BoolToVisible}}"
            ItemsSource="{x:Bind ViewModel.InstalledCards, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ModCardViewModel">
                    <controls:ModCard ViewModel="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
