<Page
    x:Class="ADOFAI.ModManager.Views.InstalledModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ADOFAI.ModManager.Controls"
    xmlns:vm="using:ADOFAI.ModManager.Core.ViewModels"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,16,28,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ── 页头与工具栏 ──  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="InstalledPage_Title"
                    Text="我的 Mod"
                    FontSize="28"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="{x:Bind ViewModel.GameRootText, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Click="ImportZip_Click" ToolTipService.ToolTip="从本地 zip 文件安装 Mod">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="导入本地 zip" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.OpenModsFolderCommand}" ToolTipService.ToolTip="在资源管理器中打开 Mods 目录">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="打开 Mods 目录" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.RescanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="重新扫描" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  ── 过滤行 ──  -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                x:Uid="InstalledPage_Search"
                PlaceholderText="搜索已安装的 Mod…"
                TextChanged="SearchBox_TextChanged"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <ComboBox
                Grid.Column="1"
                MinWidth="140"
                ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" />

            <ProgressRing
                Grid.Column="2"
                Width="24" Height="24"
                IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
        </Grid>

        <!--  ── 提示 ──  -->
        <InfoBar
            Grid.Row="2"
            IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}"
            IsClosable="True"
            CloseButtonClick="Notice_CloseClick"
            Severity="{x:Bind ViewModel.NoticeIsError, Mode=OneWay, Converter={StaticResource BoolToSeverity}}"
            Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

        <!--  ── Mod 卡片列表 ──  -->
        <ListView
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.InstalledCards, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ModCardViewModel">
                    <controls:ModCard ViewModel="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
