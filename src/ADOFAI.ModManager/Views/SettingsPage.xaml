<Page
    x:Class="ADOFAI.ModManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,16,28,12" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SettingsPage_Title"
            Text="设置"
            FontSize="28"
            FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" MaxWidth="860" HorizontalAlignment="Stretch">

                <TextBlock Text="游戏目录" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                <!--  游戏路径卡片  -->
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.GameRoot, Mode=TwoWay}"
                                PlaceholderText="例如：D:\Steam\steamapps\common\A Dance of Fire and Ice"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="浏览…" Click="PickFolder_Click" />
                            <Button Grid.Column="2" Content="校验" Command="{x:Bind ViewModel.ValidateCurrentCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Command="{x:Bind ViewModel.LocateCommand}" IsEnabled="{x:Bind ViewModel.IsLocating, Mode=OneWay, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing
                                        Width="14" Height="14"
                                        IsActive="{x:Bind ViewModel.IsLocating, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLocating, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                                    <TextBlock Text="自动定位（注册表 + Steam 库）" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenGameFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="打开游戏目录" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.CheckGameRunningCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="检测游戏是否运行" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Text="{x:Bind ViewModel.GamePathStatus, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="下载与更新" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                <!--  下载设置卡片  -->
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="最大并行下载数" FontSize="13" />
                                <TextBlock
                                    Text="同时进行的下载任务上限（1-6）"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <muxc:NumberBox
                                Grid.Column="1"
                                Value="{x:Bind ViewModel.MaxParallelDownloads, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="6"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Width="140" />
                        </Grid>

                        <ToggleSwitch
                            Header="安装/更新/卸载前检查游戏进程"
                            OnContent="已开启（推荐）"
                            OffContent="已关闭"
                            IsOn="{x:Bind ViewModel.CheckGameProcess, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!--  外观与个性化  -->
                <TextBlock Text="外观与个性化" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="应用主题" FontSize="13" />
                            <TextBlock
                                Text="选择应用的主题外观（浅色、深色或跟随 Windows 系统）"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                            MinWidth="140" />
                    </Grid>
                </Border>

                <TextBlock Text="维护与数据" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                <!--  维护卡片  -->
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ClearCacheCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="清理缓存（目录快照 / 图标 / 下载包）" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.OpenDataFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="打开数据目录" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenLogsFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C4;" FontSize="14" />
                                    <TextBlock Text="打开日志文件夹" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenTrashFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="打开卸载备份箱" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Text="应用数据目录位于：%LOCALAPPDATA%\ADOFAI.ModManager"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  关于卡片  -->
                <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9F5;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="ADOFAI Mod 管理器" FontSize="15" FontWeight="SemiBold" />
                                    <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.AppVersion}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="基于 WinUI 3 与 .NET 8 构建的《冰与火之舞》现代化开源 Mod 管理器，对接 Tuforums 社区与 UMM 规范。"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.OpenGitHubCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                    <TextBlock Text="GitHub 开源仓库" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenTuforumsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="Tuforums Mod 目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  结果提示  -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.Notice, Mode=OneWay, Converter={StaticResource StringNotEmptyToBool}}"
                    IsClosable="True"
                    Severity="Informational"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

                <TextBlock
                    Text="Apache License 2.0 开源许可 · 数据来源：Tuforums 公共 API 与本地扫描"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,4" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
