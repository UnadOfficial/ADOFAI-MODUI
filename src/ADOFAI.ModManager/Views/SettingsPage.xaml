<Page
    x:Class="ADOFAI.ModManager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    NavigationCacheMode="Enabled">

    <Grid Padding="28,16,28,12" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="SettingsPage_Title"
            Text="设置"
            FontSize="28"
            FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" HorizontalAlignment="Stretch">

                <TextBlock Text="游戏目录" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                <!--  游戏路径卡片  -->
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{x:Bind ViewModel.GameRoot, Mode=TwoWay}"
                                PlaceholderText="例如：D:\Steam\steamapps\common\A Dance of Fire and Ice"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="浏览…" Click="PickFolder_Click" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="校验" Command="{x:Bind ViewModel.ValidateCurrentCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.LocateCommand}" IsEnabled="{x:Bind ViewModel.IsLocating, Mode=OneWay, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing
                                        Width="14" Height="14"
                                        IsActive="{x:Bind ViewModel.IsLocating, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLocating, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                                    <TextBlock Text="自动定位" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenGameFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="打开游戏目录" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.CheckGameRunningCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="检测游戏是否运行" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Text="{x:Bind ViewModel.GamePathStatus, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="下载与更新" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                <!--  下载设置卡片  -->
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <!--  最大并行下载数  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="最大并行下载数" FontSize="13" />
                                <TextBlock
                                    Text="同时进行的下载任务上限（1-6）"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <muxc:NumberBox
                                Grid.Column="1"
                                Value="{x:Bind ViewModel.MaxParallelDownloads, Mode=TwoWay}"
                                Minimum="1"
                                Maximum="6"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Width="140"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!--  进程冲突检查  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="安装/更新/卸载前检查游戏进程" FontSize="13" />
                                <TextBlock
                                    Text="在执行操作前检测游戏是否处于运行状态，避免文件被占用导致损坏"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                OnContent="已开启（推荐）"
                                OffContent="已关闭"
                                IsOn="{x:Bind ViewModel.CheckGameProcess, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                MinWidth="0" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!--  GitHub 镜像加速源  -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="GitHub 镜像加速源" FontSize="13" />
                                <TextBlock
                                    Text="加速 GitHub Release 资产及下载链接解析，解决中国大陆网络环境下载缓慢或失败问题"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedGitHubMirrorOption.Description, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Visibility="{x:Bind ViewModel.SelectedGitHubMirrorOption.Description, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.GitHubMirrorOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedGitHubMirrorOption, Mode=TwoWay}"
                                DisplayMemberPath="DisplayName"
                                MinWidth="220"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!--  自定义镜像源输入（当选择“自定义镜像源…”时展示）  -->
                        <TextBox
                            Visibility="{x:Bind ViewModel.IsCustomMirror, Mode=OneWay, Converter={StaticResource BoolToVisible}}"
                            Text="{x:Bind ViewModel.CustomGitHubMirrorUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="请输入镜像源地址，例如：https://ghproxy.net/ 或包含 {url} 的模板" />

                        <!--  镜像连通性测速  -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.TestMirrorCommand}" IsEnabled="{x:Bind ViewModel.IsTestingMirror, Mode=OneWay, Converter={StaticResource InverseBool}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing
                                        Width="14" Height="14"
                                        IsActive="{x:Bind ViewModel.IsTestingMirror, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsTestingMirror, Mode=OneWay, Converter={StaticResource BoolToVisible}}" />
                                    <TextBlock Text="测试当前镜像延迟" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                Text="{x:Bind ViewModel.MirrorTestStatus, Mode=OneWay}"
                                Foreground="{x:Bind ViewModel.MirrorTestStatusColor, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.MirrorTestStatus, Mode=OneWay, Converter={StaticResource StringNotEmptyToVisible}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  外观与个性化  -->
                <TextBlock Text="外观与个性化" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="应用主题" FontSize="13" />
                            <TextBlock
                                Text="选择应用的主题外观"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                            MinWidth="180"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="在线翻译" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                <!--  翻译卡片  -->
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="详情页翻译源" FontSize="13" />
                            <TextBlock
                                Text="配置详情弹窗中 Mod 描述与更新日志的翻译引擎"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.TranslationProviderOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedTranslationProvider, Mode=TwoWay}"
                            MinWidth="220"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="维护与数据" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                <!--  维护卡片  -->
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ClearCacheCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="清理缓存" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.OpenDataFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    <TextBlock Text="打开数据目录" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenLogsFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C4;" FontSize="14" />
                                    <TextBlock Text="打开日志文件夹" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenTrashFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="打开卸载备份箱" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            Text="应用数据目录位于：%LOCALAPPDATA%\ADOFAI.ModManager"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  关于卡片  -->
                <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Border
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9F5;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="ADOFAI Mod 管理器" FontSize="15" FontWeight="SemiBold" />
                                    <Border CornerRadius="4" Padding="6,1" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.AppVersion}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="基于 WinUI 3 与 .NET 8 构建的《冰与火之舞》现代化开源 Mod 管理器。"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.OpenGitHubCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                    <TextBlock Text="GitHub 开源仓库" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenTuforumsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                                    <TextBlock Text="Tuforums Mod 目录" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  结果提示  -->
                <InfoBar
                    IsOpen="{x:Bind ViewModel.Notice, Mode=OneWay, Converter={StaticResource StringNotEmptyToBool}}"
                    IsClosable="True"
                    Severity="Informational"
                    Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

                <TextBlock
                    Text="Unad"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,4,0,16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
