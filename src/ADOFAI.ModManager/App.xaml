<Application
    x:Class="ADOFAI.ModManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ADOFAI.ModManager.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--  全局转换器  -->
            <local:StringToImageSourceConverter x:Key="StringToImageSource" />
            <local:HexToBrushConverter x:Key="HexToBrush" />
            <local:NullToVisibilityConverter x:Key="NullToCollapsed" />
            <local:InverseNullToVisibilityConverter x:Key="NullToVisible" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <local:InverseBoolToVisibilityConverter x:Key="BoolToCollapsed" />
            <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisible" />
            <local:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBool" />
            <local:BoolToSeverityConverter x:Key="BoolToSeverity" />
            <local:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
